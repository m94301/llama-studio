  --cache-type-v q8_0 \
  --gpu-layers 999 \
  --batch-size 2048 \
  --threads 1 \
  --spec-type draft-mtp \
  --spec-draft-n-max 3 \
  --draft-p-min 0.75 \
  --parallel 1 \
  --no-mmap \
  -dio \
  --jinja \
  --chat-template-file /home/m6/projects/llama_studio/templates/chat_template.jinja \
  --fit off
