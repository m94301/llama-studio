#!/usr/bin/env bash
# === llama-studio:meta BEGIN ===
# display_name: DeepSeek V4-Flash Q4_K_XL 3card - f16kv 128k
# block_count: 43
# max_context: 131072
# kv_cache_multiplier: 1024
# === llama-studio:meta END ===
LLAMA_BIN=/home/m6/projects/llama.cpp/build-cuda-avx1/bin/llama-server
export CUDA_VISIBLE_DEVICES=0,1,2

exec "$LLAMA_BIN" \
  -m /home/m6/models/drive1/unsloth/DeepSeek-V4-Flash-GGUF/DeepSeek-V4-Flash-UD-Q4_K_XL-00001-of-00005.gguf \
  --host 0.0.0.0 \
  --port 8132 \
  --ctx-size 131072 \
  --cache-type-k f16 \
  --cache-type-v f16 \
  --gpu-layers 999 \
  --split-mode layer \
  --threads 12 \
  -fa on \
  --no-mmap \
  --direct-io
