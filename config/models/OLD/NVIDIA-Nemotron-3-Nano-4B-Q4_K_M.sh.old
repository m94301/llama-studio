exec "$LLAMA_BIN" \
  -m /home/m6/models/drive1/lmstudio-community/NVIDIA-Nemotron-3-Nano-4B-GGUF/NVIDIA-Nemotron-3-Nano-4B-Q4_K_M.gguf \
  --host 0.0.0.0 \
