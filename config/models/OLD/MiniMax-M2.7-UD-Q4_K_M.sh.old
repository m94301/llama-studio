#!/usr/bin/env bash
# === llama-studio:meta BEGIN ===
# display_name: MiniMax M2.7 Q4_K_M 3card - 48tg 1135pp f16kv 160k
# block_count: 62
# max_context: 163840
# kv_cache_multiplier: 1024
# === llama-studio:meta END ===
LLAMA_BIN=/home/m6/projects/llama.cpp/build-cuda-avx1/bin/llama-server
export CUDA_VISIBLE_DEVICES=0,1,2

exec "$LLAMA_BIN" \
  -m /home/m6/models/drive1/unsloth/MiniMax-M2.7-GGUF/MiniMax-M2.7-UD-Q4_K_M-00001-of-00004.gguf \
  --host 0.0.0.0 \
  --port 8131 \
  --ctx-size 163840 \
  --cache-type-k f16 \
  --cache-type-v f16 \
  --gpu-layers 999 \
  --split-mode layer \
  --threads 12 \
  -fa on \
  --no-mmap \
  --direct-io
