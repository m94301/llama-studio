#!/usr/bin/env bash
# === llama-studio:meta BEGIN ===
# display_name: Qwen3.6 27b Nvfp4 Mtp Gguf - 31t, 160pp,  262k
# block_count: 65
# max_context: 262144
# kv_cache_multiplier: 233
# === llama-studio:meta END ===
LLAMA_BIN=/home/m6/projects/llama.cpp/build-cuda-avx1/bin/llama-server
export CUDA_VISIBLE_DEVICES=0

exec "$LLAMA_BIN" \
  -m /home/m6/models/drive1/michaelw9999/Qwen3.6-27B-NVFP4-MTP-GGUF/Qwen3.6-27B-NVFP4-MTP-GGUF.gguf \
  --host 0.0.0.0 \
  --port 8201 \
  --ctx-size 262144 \
  --cache-type-k f16 \
  --cache-type-v f16 \
  --gpu-layers 999 \
  --batch-size 512 \
  --threads 12 \
  --spec-type draft-mtp \
  --spec-draft-n-max 3 \
  --draft-p-min 0.75 \
  --parallel 1 \
  --no-mmap \
  -dio \
  --fit off
